{
    "name": "slothsoft/mtg",
    "description": "A Farah module that contains the content of mtg.slothsoft.net.",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-xsl": "*",
        "laminas/laminas-http": "^2.23.0",
        "masterminds/html5": "^2.11.0",
        "slothsoft/core": "^1.14.28",
        "slothsoft/farah": "^1.29.5",
        "slothsoft/w3c": "^1.3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "~9.6.34",
        "slothsoft/farah-testing": "^1.3.13"
    },
    "autoload": {
        "files": [
            "src/registerModule.php"
        ],
        "psr-4": {
            "Slothsoft\\MTG\\": "src/"
        }
    },
    "keywords": [
        "slothsoft",
        "farah-module",
        "docs"
    ],
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\MTG\\": "tests"
        }
    },
    "homepage": "https://faulo.github.io/slothsoft-mtg/",
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
